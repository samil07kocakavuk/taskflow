{
  "info": {
    "_postman_id": "b7a1c2d3-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
    "name": "TaskFlow",
    "description": "TaskFlow günlük görev takip API'si. Önce `npm start` ile sunucuyu çalıştır, sonra istekleri sırayla dene.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "taskId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Giriş",
      "item": [
        {
          "name": "Kayıt Ol",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('newUser', 'deneme' + Date.now());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{newUser}}\",\n  \"password\": \"123456\",\n  \"name\": \"Deneme\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Giriş Yap",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"samil\",\n  \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Ben Kimim",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Genel",
      "item": [
        {
          "name": "API Bilgisi",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          }
        },
        {
          "name": "Sağlık Kontrolü",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Görevler",
      "item": [
        {
          "name": "Listeleme",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "Ekleme",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('taskId', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sunum slaytlarini hazirla\",\n  \"description\": \"Ilk uc slayt bitsin.\",\n  \"priority\": \"high\",\n  \"assignee\": \"samil\",\n  \"project\": \"bitirme\",\n  \"dueDate\": \"2026-10-27\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "Detay",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Güncelleme",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Silme",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Filtre, Arama, Sayfalama",
      "item": [
        {
          "name": "Duruma göre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=completed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "status", "value": "completed" }]
            }
          }
        },
        {
          "name": "Önceliğe göre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?priority=high",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "priority", "value": "high" }]
            }
          }
        },
        {
          "name": "Arama",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/search?keyword=sunum",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "search"],
              "query": [{ "key": "keyword", "value": "sunum" }]
            }
          }
        },
        {
          "name": "Kişiye göre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/assignee/samil",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "assignee", "samil"]
            }
          }
        },
        {
          "name": "Sayfalama",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?page=1&limit=3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "3" }
              ]
            }
          }
        },
        {
          "name": "Sıralama",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?sort=-createdAt",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "sort", "value": "-createdAt" }]
            }
          }
        }
      ]
    },
    {
      "name": "4. Raporlar",
      "item": [
        {
          "name": "Tamamlanan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/completed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "completed"]
            }
          }
        },
        {
          "name": "Bekleyen",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "pending"]
            }
          }
        },
        {
          "name": "Özet",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "summary"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Hatalı İstekler",
      "item": [
        {
          "name": "400 - title yok",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignee\": \"samil\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "400 - geçersiz priority",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"deneme\",\n  \"assignee\": \"samil\",\n  \"priority\": \"urgent\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "404 - olmayan görev",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/9999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "9999"]
            }
          }
        },
        {
          "name": "404 - olmayan endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/yok",
              "host": ["{{baseUrl}}"],
              "path": ["api", "yok"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Çıkış",
      "item": [
        {
          "name": "Çıkış Yap",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    }
  ]
}
