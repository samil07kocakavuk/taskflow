# Sunucu portu (varsayilan: 3000)
PORT=3000

# Oturum cerezi icin gizli anahtar (production'da degistir)
SESSION_SECRET=taskflow-dev-secret

# Veri dosyalari (bos birakilirsa data/ altindakiler kullanilir)
# DATA_FILE=
# USERS_FILE=

# Log dosyasi (bos birakilirsa logs/access.log kullanilir)
# LOG_FILE=
